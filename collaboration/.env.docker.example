# Copy to .env.docker and adjust as needed:
#   cp .env.docker.example .env.docker

# Source code path (Collaboration workspace on this machine)
COLLABORATION_SOURCE=/home/mikias/workspace/company/SelamnewCollaboration

# Git branches (used by Jenkins update-from-github)
COLLABORATION_BACKEND_BRANCH=develop
COLLABORATION_FRONTEND_BRANCH=develop

# Host ports — Collaboration FE 3000, Housekeeper web 3001
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=5000
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6381
ELASTICSEARCH_HOST_PORT=9200
ADMINER_HOST_PORT=8083

# Database (postgres service + backend override)
DB_USER=postgres
DB_PASSWORD=collab_secret
DB_NAME=selamnew-collab

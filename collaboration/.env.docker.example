# Copy to .env.docker and adjust:
#   cp .env.docker.example .env.docker

# App source on this machine (build context + git pull). Not bind-mounted at runtime.
COLLABORATION_SOURCE=/home/ienetworks/workspace/company/SelamnewCollaboration

COLLABORATION_BACKEND_BRANCH=develop
COLLABORATION_FRONTEND_BRANCH=develop

# GitHub develop push → matching Jenkins job (set false to require a manual click).
COLLABORATION_WEBHOOK_DEPLOY=true

# Local registry (Jenkins build + push + compose pull)
REGISTRY=127.0.0.1:5001
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# Host ports
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=5000
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6381
ELASTICSEARCH_HOST_PORT=9200
ADMINER_HOST_PORT=8083

DB_USER=postgres
DB_PASSWORD=collab_secret
DB_NAME=selamnew-collab

NODE_ENV=development
APP_PORT=8006
APP_NAME=selamnew-notification-service
APP_DESCRIPTION=Notification and Email Service (lab)
APP_VERSION=1.0.0
APP_IS_PRODUCTION=false

# Nest config uses DB_* (not POSTGRES_*)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=nes_secret
DB_NAME=selamnew-notification
DB_TYPE=postgres
DB_SYNCHRONIZE_ENTITIES=true
DB_SSL=false

# Keep POSTGRES_* for compose db service clarity / overrides
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=nes_secret
POSTGRES_DB=selamnew-notification

FILE_SERVER_URL=http://172.16.50.39:5000
PRODUCT=COLLAB
SOURCE_SERVICE=collaboration

JWT_SECRET=lab-jwt-change-me
JWT_EXPIRES_IN=7d

COLLABORATION_SERVICE_URL=http://172.16.50.39:5000/api/v1
COLLABORATION_SERVICE_AUTH_TOKEN=Bearer lab-collaboration-token
NOTIFICATION_SERVICE_AUTH_TOKEN=Bearer lab-notification-token

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=selamnew@lab.local

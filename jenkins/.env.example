# Copy to jenkins/.env (gitignored) so compose can bind-mount the app source.
# Laptop:
# COLLABORATION_SOURCE=/home/mikias/workspace/company/SelamnewCollaboration
# Server:
# COLLABORATION_SOURCE=/home/ienetworks/workspace/company/SelamnewCollaboration
COLLABORATION_SOURCE=/home/ienetworks/workspace/company/SelamnewCollaboration
# Must match: stat -c '%g' /var/run/docker.sock  (often 110 on Ubuntu, not 124)
DOCKER_GID=110

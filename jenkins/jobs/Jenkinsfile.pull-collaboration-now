pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 50, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  stages {
    stage('Select Environment') {
      steps {
        echo "Manual pull TARGET=${params.TARGET}"
      }
    }

    stage('Backend') {
      when { expression { return params.TARGET == 'backend' || params.TARGET == 'both' } }
      steps {
        build job: 'collaboration-backend',
          wait: true,
          propagate: true,
          parameters: [
            string(name: 'ACTION', value: 'update-from-github'),
            booleanParam(name: 'SKIP_QUALITY', value: false)
          ]
      }
    }

    stage('Frontend') {
      when { expression { return params.TARGET == 'frontend' || params.TARGET == 'both' } }
      steps {
        build job: 'collaboration-frontend',
          wait: true,
          propagate: true,
          parameters: [
            string(name: 'ACTION', value: 'update-from-github'),
            booleanParam(name: 'SKIP_QUALITY', value: false)
          ]
      }
    }
  }

  post {
    success { echo "pull-collaboration-now finished TARGET=${params.TARGET}" }
    failure { echo 'Manual pull failed — see downstream console' }
  }
}

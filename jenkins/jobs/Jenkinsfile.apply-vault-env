pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 45, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  environment {
    COMPOSE_FILE = '/var/devops/collaboration/docker-compose.yml'
    ENV_FILE = '/var/devops/collaboration/.env.docker'
  }

  stages {
    stage('Select Environment') {
      steps {
        echo "TARGET=${params.TARGET}"
      }
    }

    stage('Ensure Vault unsealed') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          /var/devops/scripts/ensure-vault-unsealed.sh
        '''
      }
    }

    stage('Export Vault to env files') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          . /var/devops/jenkins/lib/ci-lib.sh
          export TARGET="${TARGET:-all}"
          export DEVOPS_HOST_PATH="$(resolve_host_devops)"
          /var/devops/scripts/vault-export-all-env.sh
        '''
      }
    }

    stage('Recreate backend (runtime env)') {
      when { expression { return params.TARGET in ['backend', 'both', 'all'] } }
      steps {
        build job: 'collaboration-backend',
          wait: true,
          propagate: true,
          parameters: [string(name: 'ACTION', value: 'recreate')]
      }
    }

    stage('Rebuild frontend (NEXT_PUBLIC is bake-time)') {
      when { expression { return params.TARGET in ['frontend', 'both', 'all'] } }
      steps {
        build job: 'collaboration-frontend',
          wait: true,
          propagate: true,
          parameters: [string(name: 'ACTION', value: 'build-and-start')]
      }
    }

    stage('Recreate notification (runtime env)') {
      when { expression { return params.TARGET in ['notification', 'all'] } }
      steps {
        build job: 'collaboration-notification',
          wait: true,
          propagate: true,
          parameters: [string(name: 'ACTION', value: 'recreate')]
      }
    }
  }

  post {
    success { echo "apply-vault-env finished TARGET=${params.TARGET}" }
    failure { echo 'apply-vault-env failed — see Console Output' }
  }
}

pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 5, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '40'))
  }

  environment {
    DEVOPS_ROOT = '/var/devops'
    BACKEND_GITHUB = 'ie-network-solutions/selamnew-collaboration-backend'
    FRONTEND_GITHUB = 'ie-network-solutions/selamnew-collaboration-fe'
    NOTIFICATION_GITHUB = 'ie-network-solutions/notification-and-email-service'
  }

  stages {
    stage('Why this job ran') {
      steps {
        script {
          def causes = currentBuild.getBuildCauses().collect { it.shortDescription }.join(' | ')
          echo "BUILD CAUSE: ${causes}"
          echo "Router: push develop|staging|production → matching tier + app job."
        }
      }
    }

    stage('Decide') {
      steps {
        script {
          def ref = env.gh_ref ?: ''
          def repo = (env.gh_repo ?: '').trim().toLowerCase()
          def repoName = (env.gh_repo_name ?: '').trim().toLowerCase()
          if (!repoName && repo.contains('/')) {
            repoName = repo.tokenize('/')[-1]
          }
          echo "gh_ref=${ref}"
          echo "gh_repo=${repo}"

          env.RUN_BACKEND = 'false'
          env.RUN_FRONTEND = 'false'
          env.RUN_NOTIFICATION = 'false'
          env.SKIP_DEPLOY = 'false'

          if (!repo && !repoName) {
            echo "No GitHub payload (manual Build Now). Webhook-only — not deploying."
            env.SKIP_DEPLOY = 'true'
            return
          }

          def pushed = ref.startsWith('refs/heads/') ? ref.substring('refs/heads/'.length()) : ref
          env.GIT_BRANCH = pushed

          def tier = 'test'
          if (pushed.contains('production')) {
            tier = 'production'
          } else if (pushed == 'staging') {
            tier = 'staging'
          } else if (pushed == 'develop' || pushed.contains('develop')) {
            tier = 'test'
          } else {
            echo "Ignoring ${ref} — only develop, staging, production trigger deploys."
            env.SKIP_DEPLOY = 'true'
            return
          }
          env.LAB_TIER = tier

          def isBackend = repo == env.BACKEND_GITHUB || repoName == 'selamnew-collaboration-backend'
          def isFrontend = repo == env.FRONTEND_GITHUB || repoName == 'selamnew-collaboration-fe'
          def isNotification = repo == env.NOTIFICATION_GITHUB || repoName == 'notification-and-email-service'

          if (isBackend && !isFrontend && !isNotification) {
            env.RUN_BACKEND = 'true'
          } else if (isFrontend && !isBackend && !isNotification) {
            env.RUN_FRONTEND = 'true'
          } else if (isNotification && !isBackend && !isFrontend) {
            env.RUN_NOTIFICATION = 'true'
          } else {
            echo "Unknown repo '${repo}'. Not starting a job."
            env.SKIP_DEPLOY = 'true'
          }

          if (env.SKIP_DEPLOY != 'true') {
            echo "→ tier=${tier} branch=${pushed} (prod: same branch → TEST/STAGING/PROD server)"
          }
        }
      }
    }

    stage('Backend from GitHub') {
      when { expression { return env.SKIP_DEPLOY != 'true' && env.RUN_BACKEND == 'true' } }
      steps {
        build job: 'collaboration-backend',
          wait: false,
          propagate: false,
          parameters: [
            string(name: 'ACTION', value: 'update-from-github'),
            string(name: 'GIT_BRANCH', value: "${env.GIT_BRANCH}"),
            string(name: 'LAB_TIER', value: "${env.LAB_TIER}"),
          ]
      }
    }

    stage('Frontend from GitHub') {
      when { expression { return env.SKIP_DEPLOY != 'true' && env.RUN_FRONTEND == 'true' } }
      steps {
        build job: 'collaboration-frontend',
          wait: false,
          propagate: false,
          parameters: [
            string(name: 'ACTION', value: 'update-from-github'),
            string(name: 'GIT_BRANCH', value: "${env.GIT_BRANCH}"),
            string(name: 'LAB_TIER', value: "${env.LAB_TIER}"),
          ]
      }
    }

    stage('Notification from GitHub') {
      when { expression { return env.SKIP_DEPLOY != 'true' && env.RUN_NOTIFICATION == 'true' } }
      steps {
        build job: 'collaboration-notification',
          wait: false,
          propagate: false,
          parameters: [
            string(name: 'ACTION', value: 'update-from-github'),
            string(name: 'GIT_BRANCH', value: "${env.GIT_BRANCH}"),
            string(name: 'LAB_TIER', value: "${env.LAB_TIER}"),
          ]
      }
    }
  }

  post {
    success { echo 'Webhook router finished' }
    failure { echo 'Webhook router failed — see downstream job console' }
  }
}

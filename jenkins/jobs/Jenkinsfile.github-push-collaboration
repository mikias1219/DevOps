pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 5, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '40'))
  }

  environment {
    DEVOPS_ROOT = '/var/devops'
    BACKEND_GITHUB = 'ie-network-solutions/selamnew-collaboration-backend'
    FRONTEND_GITHUB = 'ie-network-solutions/selamnew-collaboration-fe'
    NOTIFICATION_GITHUB = 'ie-network-solutions/notification-and-email-service'
  }

  stages {
    stage('Why this job ran') {
      steps {
        script {
          echo "BUILD CAUSE: ${currentBuild.getBuildCauses().collect { it.shortDescription }.join(' | ')}"
          echo "Router → collaboration-{backend|frontend|notification}-{test|staging|production}"
          echo "  develop → *-test   | staging → *-staging | production → *-production"
        }
      }
    }

    stage('Decide') {
      steps {
        script {
          def ref = env.gh_ref ?: ''
          def repo = (env.gh_repo ?: '').trim().toLowerCase()
          def repoName = (env.gh_repo_name ?: '').trim().toLowerCase()
          if (!repoName && repo.contains('/')) {
            repoName = repo.tokenize('/')[-1]
          }
          echo "gh_ref=${ref} gh_repo=${repo}"

          env.TARGET_JOB = ''
          env.SKIP_DEPLOY = 'false'
          env.GIT_BRANCH = ''

          if (!repo && !repoName) {
            echo "No GitHub payload — webhook-only job."
            env.SKIP_DEPLOY = 'true'
            return
          }

          def pushed = ref.startsWith('refs/heads/') ? ref.substring('refs/heads/'.length()) : ref
          env.GIT_BRANCH = pushed

          def suffix = ''
          if (pushed.contains('production')) {
            suffix = 'production'
          } else if (pushed == 'staging') {
            suffix = 'staging'
          } else if (pushed == 'develop' || pushed.contains('develop')) {
            suffix = 'test'
          } else {
            echo "Ignoring ${ref} — only develop|staging|production"
            env.SKIP_DEPLOY = 'true'
            return
          }

          def isBackend = repo == env.BACKEND_GITHUB || repoName == 'selamnew-collaboration-backend'
          def isFrontend = repo == env.FRONTEND_GITHUB || repoName == 'selamnew-collaboration-fe'
          def isNotification = repo == env.NOTIFICATION_GITHUB || repoName == 'notification-and-email-service'

          if (isBackend && !isFrontend && !isNotification) {
            env.TARGET_JOB = "collaboration-backend-${suffix}"
          } else if (isFrontend && !isBackend && !isNotification) {
            env.TARGET_JOB = "collaboration-frontend-${suffix}"
          } else if (isNotification && !isBackend && !isFrontend) {
            env.TARGET_JOB = "collaboration-notification-${suffix}"
          } else {
            echo "Unknown repo '${repo}'"
            env.SKIP_DEPLOY = 'true'
            return
          }
          echo "→ ${env.TARGET_JOB} (branch=${pushed})"
        }
      }
    }

    stage('Trigger tier job') {
      when { expression { return env.SKIP_DEPLOY != 'true' && env.TARGET_JOB } }
      steps {
        build job: "${env.TARGET_JOB}",
          wait: false,
          propagate: false,
          parameters: [
            string(name: 'ACTION', value: 'update-from-github'),
            string(name: 'GIT_BRANCH', value: "${env.GIT_BRANCH}"),
          ]
      }
    }
  }

  post {
    success { echo "Router done → ${env.TARGET_JOB ?: 'none'}" }
    failure { echo 'Webhook router failed' }
  }
}

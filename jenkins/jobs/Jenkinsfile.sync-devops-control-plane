pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 20, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '40'))
  }

  environment {
    DEVOPS_ROOT = '/var/devops'
    DEVOPS_BRANCH = 'main'
  }

  stages {
    stage('Decide') {
      steps {
        script {
          def ref = env.gh_ref ?: ''
          echo "Webhook gh_ref=${ref}"
          if (ref && !(ref in ['refs/heads/main', 'refs/heads/master'])) {
            echo "Ignoring push to ${ref} (only main/master sync the control plane)"
            env.SKIP_SYNC = 'true'
          } else {
            env.SKIP_SYNC = 'false'
          }
        }
      }
    }

    stage('Pull DevOps control plane') {
      when { expression { return env.SKIP_SYNC != 'true' } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          . /var/devops/jenkins/lib/docker-lib.sh
          . /var/devops/jenkins/lib/ci-lib.sh

          ROOT="${DEVOPS_ROOT}"
          BRANCH="${DEVOPS_BRANCH}"

          if [ ! -d "${ROOT}/.git" ]; then
            echo "FATAL: ${ROOT} is not a git checkout of the DevOps repo" >&2
            exit 1
          fi

          dirty="$(git -C "${ROOT}" status --porcelain --untracked-files=no | grep -vE '^\\?\\?' || true)"
          if [ -n "${dirty}" ]; then
            echo "FATAL: DevOps working tree has local tracked modifications:" >&2
            echo "${dirty}" >&2
            echo "Commit or stash on the server, then re-run. Never scp Jenkinsfiles." >&2
            exit 1
          fi

          BEFORE="$(git -C "${ROOT}" rev-parse HEAD)"
          git_pull_repo "${ROOT}" "${BRANCH}"
          AFTER="$(git -C "${ROOT}" rev-parse HEAD)"
          echo "DevOps ${BEFORE} -> ${AFTER}"
          git -C "${ROOT}" log -1 --oneline
        '''
      }
    }

    stage('Sync Jenkins jobs from Jenkinsfiles') {
      when { expression { return env.SKIP_SYNC != 'true' } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          if [ -f /var/devops/jenkins/secrets/admin.env ]; then
            set -a
            . /var/devops/jenkins/secrets/admin.env
            set +a
          fi
          export JENKINS_URL="${JENKINS_URL:-http://127.0.0.1:8080}"
          bash /var/devops/jenkins/bin/sync-jobs.sh
        '''
      }
    }

    stage('Refresh Jenkins compose') {
      when { expression { return env.SKIP_SYNC != 'true' } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          . /var/devops/jenkins/lib/ci-lib.sh
          HOST="$(resolve_host_devops)"
          echo "==> Ensuring jenkins compose is up (host=${HOST})"
          docker compose -f "${HOST}/jenkins/docker-compose.yml" up -d
        '''
      }
    }
  }

  post {
    success {
      echo 'Done (sync ran or intentionally skipped for a non-main branch).'
    }
    failure {
      echo 'Sync failed — check Console Output. Do not scp Jenkinsfiles; fix git and re-run.'
    }
  }
}

// Lab — same stage names & branch→environment rules as backend/Jenkinsfile (production).
// Prod: IE Jenkins → SSH → Docker Hub → Swarm. Lab: tier context + docker-lib → registry → Compose.

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 25, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  environment {
    DEVOPS_ROOT = '/var/devops'
    SERVICE = 'backend'
  }

  stages {
    stage('Select Environment') {
      steps {
        script {
          def branch = (params.GIT_BRANCH ?: '').trim()
          if (!branch && env.gh_ref) {
            branch = env.gh_ref.replace('refs/heads/', '')
          }
          if (!branch) {
            switch (params.LAB_TIER) {
              case 'staging': branch = 'staging'; break
              case 'production': branch = 'production'; break
              default: branch = 'develop'; break
            }
          }

          def tier = params.LAB_TIER ?: 'test'
          if (branch.contains('production')) {
            tier = 'production'
            env.SECRET_KEY = 'lab-production'
          } else if (branch.contains('staging')) {
            tier = 'staging'
            env.SECRET_KEY = 'lab-staging'
          } else {
            tier = 'test'
            env.SECRET_KEY = 'lab-test'
          }

          env.LAB_TIER = tier
          env.GIT_BRANCH = branch
          env.REMOTE_SERVER = 'ienetworks@172.16.50.39'
          env.SECRETS_PATH = "/var/devops/collaboration/lab-secrets/${tier}/.collab-back-env"
          env.COMPOSE_FILE = tier == 'staging'
            ? '/var/devops/collaboration/docker-compose.staging.yml'
            : tier == 'production'
              ? '/var/devops/collaboration/docker-compose.production.yml'
              : '/var/devops/collaboration/docker-compose.yml'
          env.ENV_FILE = tier == 'staging'
            ? '/var/devops/collaboration/.env.docker.staging'
            : tier == 'production'
              ? '/var/devops/collaboration/.env.docker.production'
              : '/var/devops/collaboration/.env.docker'

          echo "GIT_BRANCH=${branch} → LAB_TIER=${tier} (prod: develop→TEST, staging→STAGING, production→PROD server)"
          echo "REMOTE_SERVER=${env.REMOTE_SERVER} SECRETS_PATH=${env.SECRETS_PATH}"
          echo "ACTION=${params.ACTION}"
        }
      }
    }

    stage('Fetch Application Variables') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          export LAB_TIER="${LAB_TIER}"
          export GIT_BRANCH="${GIT_BRANCH}"
          . /var/devops/jenkins/lib/docker-lib.sh
          lab_apply_tier_context "${LAB_TIER}" "${GIT_BRANCH}"
          fetch_application_variables_backend
        '''
      }
    }

    stage('Prepare Repository') {
      when { expression { return params.ACTION != 'stop' } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          export LAB_TIER="${LAB_TIER}"
          export GIT_BRANCH="${GIT_BRANCH}"
          . /var/devops/jenkins/lib/docker-lib.sh
          lab_apply_tier_context "${LAB_TIER}" "${GIT_BRANCH}"
          prepare_repository_lab_backend
        '''
      }
    }

    stage('Pull Latest Changes') {
      when { expression { return params.ACTION == 'update-from-github' } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          export LAB_TIER="${LAB_TIER}"
          export GIT_BRANCH="${GIT_BRANCH}"
          . /var/devops/jenkins/lib/docker-lib.sh
          lab_apply_tier_context "${LAB_TIER}" "${GIT_BRANCH}"
          git_pull_repo "$(collaboration_source)/backend" "$(backend_branch)"
        '''
      }
    }

    stage('Remove existing migrations') {
      when { expression { return !['start', 'stop', 'restart', 'recreate'].contains(params.ACTION) } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          export LAB_TIER="${LAB_TIER}"
          . /var/devops/jenkins/lib/docker-lib.sh
          lab_apply_tier_context "${LAB_TIER}" "${GIT_BRANCH}"
          remove_existing_migrations_backend
        '''
      }
    }

    stage('Build and Push Docker Image') {
      when { expression { return !['start', 'stop', 'restart', 'recreate'].contains(params.ACTION) } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          export LAB_TIER="${LAB_TIER}"
          . /var/devops/jenkins/lib/docker-lib.sh
          lab_apply_tier_context "${LAB_TIER}" "${GIT_BRANCH}"
          build_and_push_collaboration_backend
        '''
      }
    }

    stage('Deploy Service') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          export LAB_TIER="${LAB_TIER}"
          . /var/devops/jenkins/lib/docker-lib.sh
          lab_apply_tier_context "${LAB_TIER}" "${GIT_BRANCH}"
          case "${ACTION}" in
            stop) stop_collaboration_service "${SERVICE}" ;;
            start|restart|recreate|build-and-start|update-from-github)
              deploy_collaboration_service "${SERVICE}" ;;
            *) echo "Unknown ACTION=${ACTION}" >&2; exit 1 ;;
          esac
        '''
      }
    }

    stage('Verify Deployment') {
      when { expression { return params.ACTION != 'stop' } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          export LAB_TIER="${LAB_TIER}"
          . /var/devops/jenkins/lib/docker-lib.sh
          lab_apply_tier_context "${LAB_TIER}" "${GIT_BRANCH}"
          wait_collaboration_backend_smoke "${SERVICE}" 40
        '''
      }
    }
  }

  post {
    success { echo "OK ${env.JOB_NAME} #${env.BUILD_NUMBER} tier=${env.LAB_TIER} ACTION=${params.ACTION}" }
    failure { echo 'Deployment failed — see Console Output.' }
  }
}

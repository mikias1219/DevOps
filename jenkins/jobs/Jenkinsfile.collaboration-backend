pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 20, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  environment {
    DEVOPS_ROOT = '/var/devops'
    COMPOSE_FILE = '/var/devops/collaboration/docker-compose.yml'
    ENV_FILE = '/var/devops/collaboration/.env.docker'
    SERVICE = 'backend'
  }

  stages {
    stage('Select Environment') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          . /var/devops/jenkins/lib/docker-lib.sh
          echo "ACTION=${ACTION}"
          print_environment
        '''
      }
    }

    stage('Fetch Application Variables') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          . /var/devops/jenkins/lib/docker-lib.sh
          SOURCE="$(collaboration_source)"
          echo "SOURCE=${SOURCE}"
          echo "BRANCH=$(backend_branch)"
          echo "DOCKERFILE=${DEVOPS_ROOT}/collaboration/docker/backend.Dockerfile"
          echo "IMAGE=$(registry_host)/collaboration-backend"
          test -d "${SOURCE}/backend" || { echo "Missing backend source at ${SOURCE}/backend" >&2; exit 1; }
        '''
      }
    }

    stage('Prepare Repository') {
      when { expression { return env.ACTION != 'stop' } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          . /var/devops/jenkins/lib/docker-lib.sh
          ensure_local_registry
          ensure_collaboration_infra
        '''
      }
    }

    stage('Pull Latest Changes') {
      when { expression { return env.ACTION == 'update-from-github' } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          . /var/devops/jenkins/lib/docker-lib.sh
          git_pull_repo "$(collaboration_source)/backend" "$(backend_branch)"
        '''
      }
    }

    stage('Build and Push Docker Image') {
      when { expression { return !['start', 'stop', 'restart', 'recreate'].contains(env.ACTION) } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          . /var/devops/jenkins/lib/docker-lib.sh
          build_and_push_collaboration_backend
        '''
      }
    }

    stage('Deploy Service') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          . /var/devops/jenkins/lib/docker-lib.sh
          case "${ACTION}" in
            stop)
              stop_collaboration_service "${SERVICE}"
              ;;
            start|restart|recreate|build-and-start|update-from-github)
              deploy_collaboration_service "${SERVICE}"
              ;;
            *)
              echo "Unknown ACTION=${ACTION}" >&2
              exit 1
              ;;
          esac
        '''
      }
    }

    stage('Verify Deployment') {
      when { expression { return env.ACTION != 'stop' } }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          . /var/devops/jenkins/lib/docker-lib.sh
          wait_collaboration_backend_smoke "${SERVICE}" 40
        '''
      }
    }
  }

  post {
    success { echo "OK ${env.JOB_NAME} #${env.BUILD_NUMBER} ACTION=${env.ACTION}" }
    failure { echo 'Deployment failed — see Console Output.' }
  }
}

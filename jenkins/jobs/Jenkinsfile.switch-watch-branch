pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 40, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  stages {
    stage('List GitHub branches') {
      steps {
        script {
          def listed = sh(
            script: """#!/usr/bin/env bash
              set -euo pipefail
              . /var/devops/jenkins/lib/docker-lib.sh
              echo "CURRENT=\$(current_watch_branch '${params.REPO}')"
              echo "DIR=\$(target_source_dir '${params.REPO}')"
              list_github_branches "\$(target_source_dir '${params.REPO}')"
            """,
            returnStdout: true,
          ).trim()

          def lines = listed.readLines().collect { it.trim() }.findAll { it }
          def current = ''
          def branches = []
          lines.each { line ->
            if (line.startsWith('CURRENT=')) {
              current = line.substring('CURRENT='.length())
            } else if (line.startsWith('DIR=')) {
              echo "Repo path: ${line.substring('DIR='.length())}"
            } else {
              branches << line
            }
          }

          if (branches.isEmpty()) {
            error "No GitHub branches found for ${params.REPO}"
          }

          if (current && branches.contains(current)) {
            branches.remove(current)
            branches.add(0, current)
          }

          echo "Currently watching: ${current ?: '(none)'}"

          timeout(time: 30, unit: 'MINUTES') {
            def chosen = input(
              id: 'PickBranch',
              message: "Watch which GitHub branch for ${params.REPO}?",
              parameters: [
                choice(
                  name: 'BRANCH',
                  choices: branches,
                  description: "Remote branches (current watch is first if present): ${current}",
                )
              ],
            )
            env.SELECTED_BRANCH = (chosen instanceof Map) ? chosen.BRANCH : chosen
          }
        }
      }
    }

    stage('Switch watch') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          . /var/devops/jenkins/lib/docker-lib.sh
          echo "REPO=${REPO} BRANCH=${SELECTED_BRANCH} REBUILD_NOW=${REBUILD_NOW}"
          switch_watch_target "${REPO}" "${SELECTED_BRANCH}" "${REBUILD_NOW}"
        '''
      }
    }

    stage('Rebuild if requested') {
      when { expression { return params.REBUILD_NOW != false && env.SELECTED_BRANCH } }
      steps {
        script {
          def repo = params.REPO
          if (repo == 'collaboration-backend' || repo == 'collaboration-both') {
            build job: 'collaboration-backend',
              wait: true,
              propagate: true,
              parameters: [
                string(name: 'ACTION', value: 'update-from-github'),
                booleanParam(name: 'SKIP_QUALITY', value: false)
              ]
          }
          if (repo == 'collaboration-frontend' || repo == 'collaboration-both') {
            build job: 'collaboration-frontend',
              wait: true,
              propagate: true,
              parameters: [
                string(name: 'ACTION', value: 'update-from-github'),
                booleanParam(name: 'SKIP_QUALITY', value: false)
              ]
          }
        }
      }
    }
  }
}

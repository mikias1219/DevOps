pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  parameters {
    choice(
      name: 'TARGET',
      choices: ['both', 'backend', 'frontend'],
      description: 'Which Collaboration repo(s) to pull from GitHub and recreate'
    )
  }

  environment {
    COMPOSE_FILE = '/var/devops/collaboration/docker-compose.yml'
    ENV_FILE = '/var/devops/collaboration/.env.docker'
  }

  stages {
    stage('Pull from GitHub (on demand)') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          # shellcheck source=/dev/null
          . /var/devops/jenkins/docker-lib.sh

          SOURCE="$(grep '^COLLABORATION_SOURCE=' "$ENV_FILE" | cut -d= -f2-)"
          BACK_BRANCH="$(grep '^COLLABORATION_BACKEND_BRANCH=' "$ENV_FILE" | cut -d= -f2- || echo develop)"
          FE_BRANCH="$(grep '^COLLABORATION_FRONTEND_BRANCH=' "$ENV_FILE" | cut -d= -f2- || echo develop)"

          echo "=== Manual pull ==="
          echo "TARGET=${TARGET}"
          echo "backend branch=${BACK_BRANCH}"
          echo "frontend branch=${FE_BRANCH}"

          case "${TARGET}" in
            backend)
              git_pull_repo "$SOURCE/backend" "$BACK_BRANCH"
              ensure_npm_packages "$SOURCE/backend"
              docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" up -d --force-recreate backend
              ;;
            frontend)
              git_pull_repo "$SOURCE/frontend" "$FE_BRANCH"
              ensure_npm_packages "$SOURCE/frontend"
              docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" up -d --force-recreate frontend
              ;;
            both)
              git_pull_repo "$SOURCE/backend" "$BACK_BRANCH"
              git_pull_repo "$SOURCE/frontend" "$FE_BRANCH"
              ensure_npm_packages "$SOURCE/backend"
              ensure_npm_packages "$SOURCE/frontend"
              docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" up -d --force-recreate backend frontend
              ;;
            *)
              echo "Unknown TARGET: ${TARGET}" >&2
              exit 1
              ;;
          esac

          echo "=== Containers ==="
          docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" ps
          echo "=== Done. Open Console Output above for full logs. ==="
        '''
      }
    }
  }

  post {
    always {
      echo "Open this build → Console Output for full logs."
    }
  }
}

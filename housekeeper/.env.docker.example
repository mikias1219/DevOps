# Copy to .env.docker and adjust as needed:
#   cp .env.docker.example .env.docker

# Source code path (Housekeeper project repo on this machine)
HOUSEKEEPER_SOURCE=/home/mikias/workspace/personal/my personal project/lifeos

# Git branches (used by Jenkins update-from-github)
HOUSEKEEPER_BACKEND_BRANCH=main
HOUSEKEEPER_FRONTEND_BRANCH=main

NODE_ENV=development

# Host ports
WEB_HOST_PORT=3001
API_HOST_PORT=4000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# Database
DATABASE_USER=housekeeper
DATABASE_PASSWORD=housekeeper_secret
DATABASE_NAME=housekeeper

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Browser-facing URLs (baked into the Next.js image at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Demo seeds (local only)
SEED_ON_START=true
SEED_TEST_DATA=true
PLATFORM_ADMIN_EMAIL=admin@gmail.com
PLATFORM_ADMIN_PASSWORD=Miki@1219
PLATFORM_ADMIN_NAME=Platform Admin
SEED_EMPLOYER_EMAIL=employer@gmail.com
SEED_EMPLOYER_PASSWORD=Miki@1219
SEED_EMPLOYER_NAME=Demo Employer
SEED_HOUSEKEEPER_EMAIL=housekeeper@gmail.com
SEED_HOUSEKEEPER_PASSWORD=Miki@1219
SEED_HOUSEKEEPER_NAME=Demo Housekeeper

# Optional integrations (leave empty locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/settings/google-callback
RESEND_API_KEY=
RESEND_FROM_EMAIL=Housekeeper <onboarding@resend.dev>
SMS_ENABLED=false
SMS_PROVIDER=console
